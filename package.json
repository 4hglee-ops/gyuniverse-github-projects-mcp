{
  "name": "gyuniverse-github-projects-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "MCP server for GitHub Projects v2 team workflows.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/mcp/stdio.ts",
    "mcp:stdio": "tsx src/mcp/stdio.ts",
    "smoke:read": "pnpm build && node dist/scripts/smoke-read.js",
    "smoke:update-single-select": "pnpm build && node dist/scripts/smoke-update-single-select.js",
    "start": "node dist/mcp/stdio.js",
    "test": "pnpm build && node --test \"dist/**/*.test.js\"",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@10.15.0",
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "dotenv": "^17.4.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
