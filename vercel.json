{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/.well-known/:path*", "destination": "/api" },
    { "source": "/oauth/:path*", "destination": "/api" },
    { "source": "/openapi.json", "destination": "/api" },
    { "source": "/api/v1/:path*", "destination": "/api" },
    { "source": "/api/admin/v1/:path*", "destination": "/api" },
    { "source": "/mcp", "destination": "/api" },
    { "source": "/health", "destination": "/api" }
  ],
  "headers": [
    { "source": "/admin/:path*", "headers": [
      { "key": "Content-Security-Policy", "value": "default-src 'none'; base-uri 'none'; form-action 'self'; connect-src 'self'; script-src 'self'; style-src 'self'; frame-ancestors 'none'" },
      { "key": "Cache-Control", "value": "no-store" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" }
    ] }
  ]
}
