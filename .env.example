# GitHub fine-grained PAT or GitHub App token with Projects permission.
# This credential stays server-side and is never issued as an MCP OAuth token.
GITHUB_TOKEN=

# Optional comma-separated owner allowlist, e.g. 4hglee-ops,gyuniverse-hq
GITHUB_PROJECTS_ALLOWED_OWNERS=4hglee-ops,gyuniverse-hq

# Optional for read operations: when empty, all Projects under an allowed owner can be read.
# Required for write operations: at least one explicit ProjectV2 node ID must be configured.
GITHUB_PROJECTS_ALLOWED_PROJECT_IDS=

# Local/server-side GitHub mutation gate. Disabled by default.
GITHUB_PROJECTS_WRITE_ENABLED=false

# Public origin of the remote MCP service, without a trailing slash.
# Example: https://projects-mcp.example.com
PUBLIC_BASE_URL=

# Human approval code entered on the OAuth authorization page.
# Set this only in the deployment secret store; do not commit a real value.
MCP_OAUTH_TEAM_CODE=

# Individual OAuth identity registry. Keep access codes only in deployment secrets.
MCP_OAUTH_IDENTITIES_JSON=

# HMAC signing secret for registered clients, authorization codes, and OAuth tokens.
# Set this only in the deployment secret store; do not commit a real value.
MCP_OAUTH_SIGNING_SECRET=

# Optional confidential OAuth client used specifically by Custom GPT Actions.
# The Client ID is entered in the GPT editor; the Client Secret is a credential and
# must exist only in deployment secrets and the GPT editor's encrypted auth config.
GPT_ACTIONS_OAUTH_CLIENT_ID=
GPT_ACTIONS_OAUTH_CLIENT_SECRET=

# Authorization-code replay store. Local development defaults to memory.
# Production and Vercel deployments must explicitly use upstash.
MCP_OAUTH_REPLAY_STORE=memory

# M10 governance persistence. Optional: when omitted and the OAuth replay store is
# Upstash, M10 reuses the same Redis deployment under separate key namespaces.
# Local development falls back to memory. Set explicitly to memory or upstash to override.
M10_GOVERNANCE_STORE=

# Upstash REST credentials. Vercel Marketplace may instead inject
# KV_REST_API_URL/KV_REST_API_TOKEN, or use the MCP_REPLAY prefix to inject
# MCP_REPLAY_KV_REST_API_URL/MCP_REPLAY_KV_REST_API_TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OAuth-level write scope switch. Disabled by default.
# Remote GitHub writes require ALL of:
# 1) MCP_OAUTH_WRITE_ENABLED=true
# 2) an OAuth token with projects:write
# 3) GITHUB_PROJECTS_WRITE_ENABLED=true
# 4) the target Project ID in GITHUB_PROJECTS_ALLOWED_PROJECT_IDS
MCP_OAUTH_WRITE_ENABLED=false

# Long-lived Node HTTP adapter. PORT is also accepted when MCP_HTTP_PORT is unset.
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=3000

# Optional smoke-test target. Defaults to http://localhost:${MCP_HTTP_PORT}.
MCP_HTTP_BASE_URL=http://localhost:3000
