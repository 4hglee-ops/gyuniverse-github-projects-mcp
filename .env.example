# GitHub fine-grained PAT or GitHub App token with Projects permission.
GITHUB_TOKEN=

# Optional comma-separated owner allowlist, e.g. 4hglee-ops,gyuniverse-hq
GITHUB_PROJECTS_ALLOWED_OWNERS=4hglee-ops,gyuniverse-hq

# Optional for read operations: when empty, all Projects under an allowed owner can be read.
# Required for write operations: at least one explicit ProjectV2 node ID must be configured.
GITHUB_PROJECTS_ALLOWED_PROJECT_IDS=

# Write operations are disabled unless explicitly set to true.
GITHUB_PROJECTS_WRITE_ENABLED=false
